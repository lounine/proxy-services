{{- define "common" -}}
    "listen": "0.0.0.0",
    "protocol": "socks",
    "settings": {
      "udp": true
    }
{{- end -}}

{"inbounds":[
  {
    "tag": "in.socks.test.out.vision.reality",
    "port": 9000,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.vision.reality.v4",
    "port": 9004,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.vision.reality.v6",
    "port": 9006,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.xray",
    "port": 9100,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.xray.v4",
    "port": 9104,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.xray.v6",
    "port": 9106,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.haproxy",
    "port": 9200,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.haproxy.v4",
    "port": 9204,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.haproxy.v6",
    "port": 9206,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.nginx",
    "port": 9300,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.nginx.v4",
    "port": 9304,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.nginx.v6",
    "port": 9306,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.caddy",
    "port": 9400,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.caddy.v4",
    "port": 9404,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.caddy.v6",
    "port": 9406,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.cdn",
    "port": 9500,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.cdn.v4",
    "port": 9504,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.cdn.v6",
    "port": 9506,
    {{ template "common" . }}
  }
]}
