{"routing":{
  "domainStrategy": "IPOnDemand",
  "rules": [
    {
      // Landing test-first-hop (172.24.0.21) here, passing test-remote (172.23.0.21) upstream
      "ip": [ "172.24.0.21" ],
      "outboundTag": "test-container"
    },
    {
      "ip": [ "geoip:ru" ],
      "outboundTag": "internet"
    },
    {
      "inboundTag": [ "in.vision.reality" ],
      "outboundTag": "out.vision.reality"
    },
    {
      "inboundTag": [ "in.xhttp" ],
      "outboundTag": "out.xhttp.direct"
    },
    {
      "inboundTag": [ "in.socks" ],
      "outboundTag": "out.xhttp.direct"
    },

    {
      "inboundTag": [ "in.socks.test.out.vision.reality" ],
      "outboundTag": "out.vision.reality"
    },
    {
      "inboundTag": [ "in.socks.test.out.vision.reality.v4" ],
      "outboundTag": "out.vision.reality.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.vision.reality.v6" ],
      "outboundTag": "out.vision.reality.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.direct" ],
      "outboundTag": "out.xhttp.direct"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.direct.v4" ],
      "outboundTag": "out.xhttp.direct.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.direct.v6" ],
      "outboundTag": "out.xhttp.direct.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn" ],
      "outboundTag": "out.xhttp.cdn"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn.v4" ],
      "outboundTag": "out.xhttp.cdn.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn.v6" ],
      "outboundTag": "out.xhttp.cdn.v6"
    }
  ]
}}
