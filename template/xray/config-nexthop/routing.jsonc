{"routing":{
  "domainStrategy": "IPOnDemand",
  "rules": [
    {
      // Landing test-first-hop (172.24.0.21) here, passing test-remote (172.23.0.21) upstream
      "ip": [ "172.24.0.21" ],
      "outboundTag": "test-container"
    },
    {
      "ip": [ "geoip:ru" ],
      "outboundTag": "internet"
    },
    {
      "inboundTag": [ "in.vision.reality" ],
      "outboundTag": "out.vision.reality"
    },
    {
      "inboundTag": [ "in.xhttp.insecure", "in.socks.tls" ],
      "outboundTag": "out.xhttp.stream-up"
    },
    {
      "inboundTag": [ "in.socks" ],
      "outboundTag": "out.xhttp.stream-up"
    },

    {
      "inboundTag": [ "in.socks.test.out.vision.reality" ],
      "outboundTag": "out.vision.reality"
    },
    {
      "inboundTag": [ "in.socks.test.out.vision.reality.v4" ],
      "outboundTag": "out.vision.reality.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.vision.reality.v6" ],
      "outboundTag": "out.vision.reality.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.xray" ],
      "outboundTag": "out.xhttp.xray"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.xray.v4" ],
      "outboundTag": "out.xhttp.xray.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.xray.v6" ],
      "outboundTag": "out.xhttp.xray.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.haproxy" ],
      "outboundTag": "out.xhttp.haproxy"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.haproxy.v4" ],
      "outboundTag": "out.xhttp.haproxy.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.haproxy.v6" ],
      "outboundTag": "out.xhttp.haproxy.v6"
    },
    
    {
      "inboundTag": [ "in.socks.test.out.xhttp.nginx" ],
      "outboundTag": "out.xhttp.nginx"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.nginx.v4" ],
      "outboundTag": "out.xhttp.nginx.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.nginx.v6" ],
      "outboundTag": "out.xhttp.nginx.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.caddy" ],
      "outboundTag": "out.xhttp.caddy"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.caddy.v4" ],
      "outboundTag": "out.xhttp.caddy.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.caddy.v6" ],
      "outboundTag": "out.xhttp.caddy.v6"
    },

    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn" ],
      "outboundTag": "out.xhttp.cdn"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn.v4" ],
      "outboundTag": "out.xhttp.cdn.v4"
    },
    {
      "inboundTag": [ "in.socks.test.out.xhttp.cdn.v6" ],
      "outboundTag": "out.xhttp.cdn.v6"
    }
  ]
}}
