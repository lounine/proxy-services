{{- define "settings" -}}
      "address": "{{ index .nexthop.xray.xhttp.domains.xray 0 }}",
      "port": 443,
      "id": "{{ .params.nexthop.xray.user }}",
      "encryption": "none"
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "/{{ .nexthop.xray.xhttp.path | strings.Trim "/" }}",
        "mode": "packet-up"
      },
      "security": "tls",
      "tlsSettings": {
        "fingerprint": "chrome"
      }
{{- end -}}


{"outbounds":[
  {
    "tag": "out.xhttp.xray",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "out.xhttp.xray.v4",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv4"
      }
    }
  },
  {
    "tag": "out.xhttp.xray.v6",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv6"
      }
    }
  }
]}
