{"inbounds":[{
  "tag": "in.vision.reality",
  "listen": "0.0.0.0",
  "port": 1443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret, flow:"xtls-rprx-vision"}]` | toJSON }}
  },
  "streamSettings": {
    "network": "raw",
    "security": "reality",
    "realitySettings": {
      "show": {{ eq .log.level "debug" }},
      "target": "nginx:8443",
      "serverNames": [ {{ range $i, $domain := .local.xray.reality.domains }}
                       {{- if $i }}, {{ end }}{{ $domain | quote }}
                       {{- end }} ],
      "privateKey": "{{ .local.xray.reality.privateKey }}",
      "shortIds": [ "" ]
    }
  }
}]}
