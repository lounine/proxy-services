{"routing":{
  "domainStrategy": "IPOnDemand",
  "rules": [
    {
      // Both test-remote (172.23.0.21) and test-first-hop (172.24.0.21) end here
      "ip": [ "172.23.0.21", "172.24.0.21" ],
      "outboundTag": "test-container"
    },
    {
      "ip": [ "geoip:ru" ],
      "outboundTag": "block"
    },
    {
      "ip": [ "0.0.0.0/0", "::/0"],
      "outboundTag": "internet"
    }
  ]
}}
