{{- define "settings" -}}
      "decryption": "none",
      "clients": {{ .users.xray | jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "/{{ .local.xray.xhttp.path | strings.Trim "/" }}"
      }
{{- end -}}

{"inbounds":[
  {
    "tag": "in.xhttp.insecure",
    "listen": "0.0.0.0",
    "port": 2443,
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "in.xhttp.tls",
    "listen": "0.0.0.0",
    "port": 3443,
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "security": "tls",
      "tlsSettings": {
        "serverName": "",
        "certificates": {{ .local.xray.xhttp.domains.xray |
          jq `[.[] | {
            certificateFile: "/certs/" + . + ".crt", 
            keyFile: "/certs/" + . + ".key"
          }]` | toJSON }}
      }
    }
  }
]}
