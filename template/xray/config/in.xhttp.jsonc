{{- define "settings" -}}
      "decryption": "none",
      "clients": {{ .users.xray | jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "/{{ .local.xray.xhttp.path | strings.Trim "/" }}"
      }
{{- end -}}

{"inbounds":[
  {
    "tag": "in.xhttp",
    "listen": "0.0.0.0",
    "port": 80,
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }}
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  }
]}
