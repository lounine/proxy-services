{
  admin off
  auto_https disable_redirects    # impossible to get rid of "Server: Caddy" header with automatic redirects
  log default {
    level {{ if eq .log.level "warning" -}} WARN {{- else }}{{ strings.ToUpper .log.level }}{{ end }}  
    output stdout
    format console
  }
}

:80 {
  header -Server      # don't reveal we are using caddy
  redir https://{host}{uri} 308
}

{{ .local.xray.reality.domain }}, {{ .params.telegram.domain }} ,
{{ .local.xray.xhttp.domain }}, {{ .local.xray.xhttp.cdn_domain }} {
  header -Server      # don't reveal we are using caddy

  tls {
    issuer acme {
      disable_tlsalpn_challenge      # wouldn't work behind a CDN anyway
    }
  }

  @xhttp_path path {{ .local.xray.xhttp.path }}/*

  @no_specific_match {
    not path {{ .local.xray.xhttp.path }}/*
  }

  reverse_proxy @xhttp_path 172.22.0.11:2443

  respond @no_specific_match "Access denied" 403 {
    close
  }
}
