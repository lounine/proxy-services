{
  admin off
  auto_https disable_redirects    # impossible to get rid of "Server: Caddy" header with automatic redirects
  log default {
    level {{ if eq .log.level "warning" -}} WARN {{- else }}{{ strings.ToUpper .log.level }}{{ end }}  
    output stdout
    format console
  }

  servers {
    protocols h1 h2               # Exclude http/3 and do not bind to udp/443
  }
}

:80 {
  header -Server      # don't reveal we are using caddy
  redir https://{host}{uri} 308
}

{{ join .local.xray.reality.domains ", "}},
{{ join .local.xray.xhttp.domains ", "}},
{{ .params.telegram.domain }} {
  header -Server      # don't reveal we are using caddy

  tls {
    issuer acme {
      disable_tlsalpn_challenge      # wouldn't work behind a CDN anyway
    }
  }

  reverse_proxy {
    to https://pkgs.alpinelinux.org
  }

  reverse_proxy {{ .local.xray.xhttp.path }}/* {
    to h2c://172.22.0.11:2443
    flush_interval -1
  }
}
