{
  admin off
  auto_https disable_redirects    # Impossible to get rid of "Server: Caddy" header with automatic redirects 

  servers {
    protocols h1 h2               # Exclude http/3 and do not bind to udp/443
  }
}

(match-websocket) {
  header Connection *Upgrade*
  header Upgrade    websocket
}

(xray-ws-common) {
  rewrite /                       # Strip path as xray expects
  transport http {
    versions 2 
  }
}

:80 {
  header -Server
  redir https://{host}{uri} permanent
}

{{ .settings.xray.websocket.accessDomain }} {
  reverse_proxy {{ .settings.xray.websocket.fakeSource }}

  @xray-ws-trojan {
    path {{ print "/" .settings.xray.websocket.trojan.secret }}
    import match-websocket
  }
  reverse_proxy @xray-ws-trojan {
    to xray:8081
    import xray-ws-common
  }

  @xray-ws-vless {
    path {{ print "/" .settings.xray.websocket.vless.secret }}
    import match-websocket
  }
  reverse_proxy @xray-ws-vless {
    to xray:8082
    import xray-ws-common
  }

  @xray-ws-vmess {
    path {{ print "/" .settings.xray.websocket.vmess.secret }}
    import match-websocket
  }
  reverse_proxy @xray-ws-vmess {
    to xray:8083
    import xray-ws-common
  }
}
