{"outbounds":[{
  "tag": "out.vision.reality",
  "protocol": "vless",
  "settings": {
    "address": "{{ index .nexthop.xray.reality.domains 0 }}",
    "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
    "id": "{{ .params.nexthop.xray.user }}",
    "flow": "xtls-rprx-vision",
    "encryption": "none"
  },
  "streamSettings": {
    "network": "raw",
    "security": "reality",
    "realitySettings": {
      "fingerprint": "chrome", 
      "serverName": "{{ index .nexthop.xray.reality.domains 0 }}",
      "publicKey": "{{ .nexthop.xray.reality.publicKey }}"
    }
  }
}]}
