{{- define "common" -}}
    "listen": "0.0.0.0",
    "protocol": "socks",
    "settings": {
      "udp": true
    }
{{- end -}}

{"inbounds":[
  {
    "tag": "in.socks.test.out.vision.reality",
    "port": 9000,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.vision.reality.v4",
    "port": 9004,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.vision.reality.v6",
    "port": 9006,
    {{ template "common" . }}
  },


  {
    "tag": "in.socks.test.out.xhttp.stream-up.direct",
    "port": 9100,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.stream-up.direct.v4",
    "port": 9104,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.stream-up.direct.v6",
    "port": 9106,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.stream-up.nginx",
    "port": 9110,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.stream-up.nginx.v4",
    "port": 9114,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.stream-up.nginx.v6",
    "port": 9116,
    {{ template "common" . }}
  },


  {
    "tag": "in.socks.test.out.xhttp.packet-up.direct",
    "port": 9200,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.packet-up.direct.v4",
    "port": 9204,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.packet-up.direct.v6",
    "port": 9206,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.xhttp.packet-up.nginx",
    "port": 9210,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.packet-up.nginx.v4",
    "port": 9214,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.xhttp.packet-up.nginx.v6",
    "port": 9216,
    {{ template "common" . }}
  },


  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.direct",
    "port": 9300,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.direct.v4",
    "port": 9304,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.direct.v6",
    "port": 9306,
    {{ template "common" . }}
  },

  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.nginx",
    "port": 9310,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.nginx.v4",
    "port": 9314,
    {{ template "common" . }}
  },
  {
    "tag": "in.socks.test.out.cdn.xhttp.packet-up.nginx.v6",
    "port": 9316,
    {{ template "common" . }}
  }
]}
