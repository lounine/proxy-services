{{- define "settings" -}}
      "address": "{{ index .nexthop.xray.xhttp.domains 1 }}",
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      "id": "{{ .params.nexthop.xray.user }}",
      "encryption": "none"
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "{{ .nexthop.xray.xhttp.path }}",
        "mode": "packet-up"
      },
      "security": "tls",
      "tlsSettings": {
        "fingerprint": "chrome"
      }
{{- end -}}


{"outbounds":[
  {
    "tag": "out.cdn.xhttp.packet-up",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.v4",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv4"
      }
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.v6",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv6"
      }
    }
  }
]}
