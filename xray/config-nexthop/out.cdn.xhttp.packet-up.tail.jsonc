{{- define "settings" -}}
      "address": "{{ index .nexthop.xray.xhttp.domains 1 }}",
      "id": "{{ .params.nexthop.xray.user }}",
      "encryption": "none"
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "{{ .nexthop.xray.xhttp.path }}",
        "mode": "packet-up"
      },
      "security": "tls",
      "tlsSettings": {
        "fingerprint": "chrome"
      }
{{- end -}}


{"outbounds":[
{
    "tag": "out.cdn.xhttp.packet-up.direct",
    "protocol": "vless",
    "settings": {
      "port": 8443,
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.direct.v4",
    "protocol": "vless",
    "settings": {
      "port": 8443,
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv4"
      }
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.direct.v6",
    "protocol": "vless",
    "settings": {
      "port": 8443,
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv6"
      }
    }
  },

  {
    "tag": "out.cdn.xhttp.packet-up.nginx",
    "protocol": "vless",
    "settings": {
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.nginx.v4",
    "protocol": "vless",
    "settings": {
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv4"
      }
    }
  },
  {
    "tag": "out.cdn.xhttp.packet-up.nginx.v6",
    "protocol": "vless",
    "settings": {
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv6"
      }
    }
  }
]}
