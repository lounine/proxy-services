{"outbounds":[{
  "tag": "out.xhttp.stream-up",
  "protocol": "vless",
  "settings": {
    "address": "{{ index .nexthop.xray.xhttp.domains 0 }}",
    "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
    "id": "{{ .params.nexthop.xray.user }}",
    "encryption": "none"
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "{{ .nexthop.xray.xhttp.path }}",
      "mode": "stream-up"
    },
    "security": "tls",
    "tlsSettings": {
      "fingerprint": "chrome"
    },
    "sockopt": {
      "domainStrategy": "UseIPv6v4"
    }
  }
}]}
