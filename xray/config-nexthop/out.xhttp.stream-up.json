{"outbounds":[{
  "tag": "xhttp.stream-up",
  "protocol": "vless",
  "settings": {
    "vnext": [{
      "address": "{{ .local.address }}",
      "port": {{ .local.port }},
      "users": [{{ .params.nexthop.xray.user |
        jq `{id:., encryption:"none"}` | toJSON }}]
    }]
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "/api/v1/id/",
      "mode": "stream-up"
    },
    "security": "reality",
    "realitySettings": {
      "fingerprint": "chrome", 
      "serverName": "{{ .nexthop.xray.xhttp.SNI }}",
      "publicKey": "{{ .nexthop.xray.reality.publicKey }}"
    }
  }
}]}
