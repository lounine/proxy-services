{"outbounds":[{
  "tag": "xhttp.packet-up",
  "protocol": "vless",
  "settings": {
    "vnext": [{
      "address": "{{ .nexthop.xray.xhttp.cdn_domain }}",
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      "users": [{{ .params.nexthop.xray.user |
        jq `{id:., encryption:"none"}` | toJSON }}]
    }]
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "{{ .nexthop.xray.xhttp.path }}",
      "mode": "packet-up"
    },
    "security": "tls",
    "tlsSettings": {
      "fingerprint": "chrome"
    }
  }
}]}
