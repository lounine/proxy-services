{{- define "settings" -}}
      "address": "{{ index .nexthop.xray.xhttp.domains 0 }}",
      "port": {{ if has .nexthop "port" }}{{ .nexthop.port }}{{ else }}443{{ end }},
      "id": "{{ .params.nexthop.xray.user }}",
      "encryption": "none"
{{- end -}}

{{- define "streamSettings" -}}
      "network": "xhttp",
      "xhttpSettings": {
        "path": "{{ .nexthop.xray.xhttp.path }}",
        "mode": "stream-up"
      },
      "security": "tls",
      "tlsSettings": {
        "fingerprint": "chrome"
      }
{{- end -}}

{"outbounds":[
  {
    "tag": "out.xhttp.stream-up",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }}
    }
  },
  {
    "tag": "out.xhttp.stream-up.v4",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv4"
      }
    }
  },
  {
    "tag": "out.xhttp.stream-up.v6",
    "protocol": "vless",
    "settings": {
      {{ template "settings" . }} 
    },
    "streamSettings": {
      {{ template "streamSettings" . }},
      "sockopt": {
        "domainStrategy": "ForceIPv6"
      }
    }
  }
]}
