{"inbounds":[{
  "tag": "reality",
  "listen": "0.0.0.0",
  "port": 1443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret, flow:"xtls-rprx-vision"}]` | toJSON }}
  },
  "streamSettings": {
    "network": "raw",
    "security": "reality",
    "realitySettings": {
      "show": {{ eq .log.level "debug" }},
      "target": "172.22.0.10:443",
      "serverNames": [ "{{ .local.xray.reality.domain }}" ],
      "privateKey": "{{ .local.xray.reality.privateKey }}",
      "shortIds": [ "" ]
    }
  }
}]}
