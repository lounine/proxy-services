{"inbounds":[{
  "tag": "in.xhttp.insecure",
  "listen": "0.0.0.0",
  "port": 2443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "{{ .local.xray.xhttp.path }}"
    }
  }
}]}
