{"inbounds":[{
  "tag": "xhttp",
  "listen": "0.0.0.0",
  "port": 2443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "/api/v1/id/"
    },
    "security": "reality",
    "realitySettings": {
      "show": {{ eq .log.level "debug" }},
      "target": "172.22.0.10:443",
      "serverNames": [ 
{{- range $i, $domain := .local.xray.xhttp.domains}}
{{- if $i }},{{ end }} {{ $domain | quote }}
{{- end }} ],
      "privateKey": "{{ .local.xray.reality.privateKey }}",
      "shortIds": [ "" ]
    }
  }
}]}
