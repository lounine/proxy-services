{"inbounds":[{
  "tag": "xhttp",
  "listen": "0.0.0.0",
  "port": 2443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "/api/v2/objects/"
    },
    "security": "reality",
    "realitySettings": {
      "show": {{ getenv "DEBUG" "false" }},
      "target": "{{ .settings.xray.xhttp.SNI }}:443",
      "serverNames": [ "{{ .settings.xray.xhttp.SNI }}" ],
      "privateKey": "{{ .settings.xray.reality.privateKey }}",
      "shortIds": [ "" ]
    }
  }
}]}
