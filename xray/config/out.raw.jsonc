{"outbounds":[
  {
    // This rule comes first to block all traffic that was not explicitly routed
    "tag": "block",
    "protocol": "blackhole"
  },
  {
    "tag": "test-container",
    "protocol": "freedom",
    "settings": {
      "redirect": "test:0"
    }
  },
  {
    "tag": "internet",
    "protocol": "freedom",
    "settings": {
      "finalRules": [
        {
          "action": "block",
          "ip": [ "geoip:private" ]
        }
      ]
    }
  }
]}
