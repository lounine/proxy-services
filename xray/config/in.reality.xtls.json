{"inbounds":[{
  "tag": "reality.xtls",
  "listen": "0.0.0.0",
  "port": 443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret, flow:"xtls-rprx-vision"}]` | toJSON }}
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "target": "{{ .settings.xray.reality.target }}:443",
      "serverNames": [ "{{ .settings.xray.reality.target }}" ],
      "privateKey": "{{ .settings.xray.reality.privateKey }}",
      "shortIds": [ "" ]
    }
  }
}]}
