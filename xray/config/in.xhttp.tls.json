{"inbounds":[{
  "tag": "in.xhttp.tls",
  "listen": "0.0.0.0",
  "port": 3443,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "fallbacks": [{
      "dest": "pkgs.alpinelinux.org:443"
    }],
    "clients": {{ .users.xray |
      jq `[.clients[] | {email:.name, id:.secret}]` | toJSON }}
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "{{ .local.xray.xhttp.path }}"
    },
    "security": "tls",
    "tlsSettings": {
      "certificates": [{
        "certificateFile": "/usr/local/share/certs/fullchain.cer",
        "keyFile": "/usr/local/share/certs/private.key"
      }]
    }
  }
}]}
